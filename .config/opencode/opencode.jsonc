{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",

      "pwd": "allow",
      "pwd *": "allow",

      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current": "allow",
      "git branch -vv": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",

      "gh auth status": "allow",
      "gh pr view *": "allow",

      "mix compile": "allow",
      "mix compile *": "allow",
      "mix format": "allow",
      "mix format *": "allow",
      "mix test": "allow",
      "mix test *": "allow",
      "mix precommit": "allow",
      "mix precommit *": "allow",
      "mix quality": "allow",
      "mix quality *": "allow",

      "make -n *": "allow",
      "make help": "allow",
      "make soft-test": "allow",
      "make soft-test *": "allow",

      "bash -n *": "allow",
      "zsh -n *": "allow",
      "python3 -m json.tool *": "allow",
      "python3 -m py_compile *": "allow",

      "doom --version": "allow",
      "doom doctor": "allow",

      "herdr --help": "allow",
      "herdr --version": "allow",
      "herdr * --help": "allow",
      "herdr status *": "allow",
      "herdr api snapshot": "allow",
      "herdr api schema *": "allow",
      "herdr plugin *": "allow",
      "herdr workspace *": "allow",
      "herdr agent *": "allow",
      "herdr worktree list *": "allow",

      "podman ps *": "allow",
      "docker-compose * ps *": "allow",
      "diskutil list *": "allow"
    }
  }
}
