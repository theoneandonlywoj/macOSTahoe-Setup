# Template for the 4-tab workspace created by new-workspace-4-tabs.zsh.
# Copy this file to ~/.config/herdr/scripts/.env to customize per machine
# (.env is git-ignored; .env.example is committed to the repo).
# new-workspace-4-tabs.zsh greps the .env (or .env.example) file for
# HERDR_4TAB_* keys (values may be quoted). Shell environment variables of
# the same name take precedence over the file.

# Harness priority order (space-separated). Tried left-to-right; the first harness
# with an installed binary wins. Used for both agent-high and agent-low tabs.
HERDR_4TAB_HARNESS_ORDER="claude codex opencode"

# agent-high / agent-low launch commands per harness.
# Auto-accepting edits + high-thinking model for the HIGH variants.
HERDR_4TAB_CLAUDE_HIGH="claude --permission-mode acceptEdits --model opus --effort max"
HERDR_4TAB_CODEX_HIGH="codex --approve-for-me -m gpt-5.6-sol -c model_reasoning_effort=high"
HERDR_4TAB_OPENCODE_HIGH="opencode --auto --variant high -m opencode-go/gpt-5.6-sol"

# Small-task model for the LOW variants (commit messages, PR descriptions).
HERDR_4TAB_CLAUDE_LOW="claude --permission-mode acceptEdits --model haiku"
HERDR_4TAB_CODEX_LOW="codex --approve-for-me -m gpt-5.4-mini"
HERDR_4TAB_OPENCODE_LOW="opencode --auto -m opencode/deepseek-v4-flash-free"

# Optional: override workspace/tab defaults.
# HERDR_4TAB_CWD="/path/to/project"
# HERDR_4TAB_WORKSPACE_LABEL="project-agents"
# HERDR_4TAB_TAB1_LABEL="agent-high"
# HERDR_4TAB_TAB2_LABEL="git"
# HERDR_4TAB_TAB3_LABEL="shell"
# HERDR_4TAB_TAB4_LABEL="agent-low"
